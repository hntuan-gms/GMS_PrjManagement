# Jira Cloud connection — leave these 4 EMPTY (as shipped) to run in MOCK
# mode with sample HHBJ-like data. Fill all 4 in to connect to real Jira.
JIRA_BASE_URL=
JIRA_EMAIL=
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Example values for gimasys.atlassian.net / project HHBJ:
# JIRA_BASE_URL=https://gimasys.atlassian.net
# JIRA_EMAIL=your.email@gimasys.com
# JIRA_API_TOKEN=xxxxxxxxxxxxxxxx
# JIRA_PROJECT_KEY=HHBJ

# Optional: custom field ID of Jira's native "Start date" field, if this project
# has one (Team-managed projects often do). When set, the app reads/writes start
# date directly on Jira instead of keeping it purely local. Defaults to
# customfield_10059 (HHBJ's Start date field on gimasys.atlassian.net).
JIRA_START_DATE_FIELD_ID=customfield_10059

# Local server port
PORT=4000
