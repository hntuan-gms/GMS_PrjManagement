# --- Atlassian OAuth 2.0 (3LO) ---
# Register an app at https://developer.atlassian.com/console/myapps
#   Permissions -> Jira API -> classic scopes:
#     read:jira-work  write:jira-work  read:jira-user
#   Authorization -> OAuth 2.0 (3LO) -> enable offline_access
#   Callback URL must EXACTLY equal $APP_BASE_URL/api/auth/callback
#
# Atlassian allows only ONE callback URL per app, so local dev and production
# need two separate apps with their own client id/secret.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Where this instance is reachable. Used to derive the redirect URI — deliberately
# NOT taken from the Host header, which is attacker-controlled.
# Dev goes through the Vite proxy on :5173, so use that, not :4000.
APP_BASE_URL=http://localhost:5173

# Keyring that seals the session cookies. First entry encrypts; every entry can
# decrypt, so a key is rotated by PREPENDING a new one, deploying, waiting out the
# 30-day cookie lifetime, then removing the old one. Replacing the list outright
# logs every user out immediately.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64url'))"
SESSION_ENCRYPTION_KEYS=

# Who may log in: Atlassian site hostname(s), comma-separated. A user is allowed
# in exactly when an admin has already invited them to one of these Jira sites —
# which is what makes guests on personal or client-company addresses work without
# any list to maintain here. Required; the server exits at boot without it, because
# the service is publicly reachable and an unset value would admit anyone.
# This also picks WHICH site the session binds to, so a guest who has their own
# company's Atlassian site too still lands on ours.
ALLOWED_SITE_HOSTS=gimasys.atlassian.net

# Marks internal staff. NOT a login gate — guests log in fine without matching it.
# It only gates /api/ai/* (assistant + planner), which bills against the shared
# Gemini key. Leave empty to treat everyone as staff.
STAFF_EMAIL_DOMAIN=gimasys.com

# --- Database (Postgres) ---
# Holds everything Jira cannot: durations, FS/SS/FF/SF dependencies with lag,
# baselines, % complete, the resource pool and the AI planner's staged proposals.
# The server exits at boot without it and runs pending migrations on startup.
#
# Local dev:  docker compose up -d db   (then the URL below works as-is)
# Cloud Run:  use the Cloud SQL unix socket, which needs no TLS settings —
#   postgresql://USER:PASS@/gms?host=/cloudsql/PROJECT:REGION:INSTANCE
#   and deploy with --add-cloudsql-instances=PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://gms:gms@localhost:5432/gms

# Only for reaching a managed Postgres over a public IP; leave unset for the
# Cloud SQL socket or for local docker.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# --- AI planner (optional) ---
# Only the /api/ai routes need these; the rest of the app runs without them.
# GEMINI_API_KEY is shared with the video-agent service via Secret Manager in
# production. GEMINI_MODEL overrides the default in server/src/ai/planner.ts —
# call GET /api/ai/models (logged in) to see which names the key can actually
# use, rather than trusting any list written down here.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Optional: force a specific "Start date" custom field id instead of discovering
# it per site. Only needed if a site names that field something unusual.
# JIRA_START_DATE_FIELD_ID=customfield_10059

# Local server port
PORT=4000
